# ── Mode ─────────────────────────────────────────────────────────────
# DEMO_MODE=true (or `npm run demo`) runs without any external service:
# posts are checked against text the participant pastes, X linking is a
# typed handle, payouts are simulated. Leave unset for production.
DEMO_MODE=false

PORT=3000
# Public URL of this server (used for cookies + the X OAuth callback)
BASE_URL=http://localhost:3000

# Long random string. Sessions are invalidated when it changes.
SESSION_SECRET=change-me-to-a-long-random-string

# Password for /admin
ADMIN_PASSWORD=change-me

# Optional branding
BRAND_NAME=Questboard
BRAND_TAGLINE=Post about the projects you believe in. Get paid on-chain when it checks out.

# ── X (Twitter) ──────────────────────────────────────────────────────
# Read access for post lookup + engagement (X API v2, Basic tier or above).
# Without it, posts are fetched through the public oEmbed endpoint
# (text + author only, no engagement metrics → ranked quests cannot score).
X_BEARER_TOKEN=

# OAuth 2.0 app (User authentication settings → type "Web App", callback below).
# Participants link their X account through this; the server only asks for
# tweet.read + users.read.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3000/auth/x/callback

# Force a provider: auto | xapi | oembed | mock   (auto = xapi if token, else oembed)
TWEET_PROVIDER=auto
# Point at a relay/proxy if your host cannot reach api.x.com directly
X_API_BASE=https://api.x.com

# ── Escrow wallet ────────────────────────────────────────────────────
# Private key of the wallet that pays rewards. Fund it with the reward
# tokens AND native coin for gas on every chain you pay on.
ESCROW_PRIVATE_KEY=
# Optional RPC override for the default chain
ESCROW_RPC_URL=
# base | base-sepolia | ethereum | sepolia | arbitrum | optimism | polygon | bsc | avalanche
DEFAULT_CHAIN=base
TX_CONFIRMATIONS=1

# ── Scheduler ────────────────────────────────────────────────────────
SCHEDULER_TICK_MS=15000
ENGAGEMENT_REFRESH_MINUTES=15
REWARD_MAX_ATTEMPTS=5
# DISABLE_SCHEDULER=true

# ── Storage ──────────────────────────────────────────────────────────
# DB_PATH=./data/questing.db
# LOG_LEVEL=info
